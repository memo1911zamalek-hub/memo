:root{
  --night:#04140e; --pitch:#0e5a3f; --pitch2:#0b4a34; --chalk:#f4f7f2;
  --gold:#ffd23f; --red:#e63946; --ok:#2ecc71; --glass:rgba(255,255,255,.08);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  font-family:'Tajawal',Tahoma,Arial,sans-serif; color:var(--chalk);
  background:linear-gradient(#020b08,var(--night) 55%,#0a2a1e);
  overflow-x:hidden; display:flex; justify-content:center;
}
#fx{position:fixed;inset:0;pointer-events:none;z-index:50}

/* أضواء الملعب */
.lights{position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
   radial-gradient(ellipse 30% 40% at 12% 0%,rgba(255,240,170,.28),transparent 70%),
   radial-gradient(ellipse 30% 40% at 88% 0%,rgba(255,240,170,.28),transparent 70%)}

/* أرضية ملعب ثلاثية الأبعاد */
.field{position:fixed;left:-30%;right:-30%;bottom:0;height:55vh;z-index:0;
  transform:perspective(520px) rotateX(64deg);transform-origin:50% 100%;
  background:
   radial-gradient(circle at 50% 50%,transparent 0 17%,rgba(255,255,255,.55) 17% 18%,transparent 18%),
   linear-gradient(rgba(255,255,255,.5) 0 0) 50% 50%/4px 100% no-repeat,
   repeating-linear-gradient(90deg,var(--pitch) 0 70px,var(--pitch2) 70px 140px);
  animation:slide 14s linear infinite;
  box-shadow:inset 0 80px 120px var(--night)}
@keyframes slide{to{background-position:0 0,50% 50%,140px 0}}

#app{position:relative;z-index:2;width:100%;max-width:660px;padding:22px 16px 40px;
  display:flex;align-items:center;min-height:100vh}
.screen{display:none;width:100%;text-align:center}
.screen.show{display:block;animation:enter .6s cubic-bezier(.2,.8,.2,1)}
@keyframes enter{from{opacity:0;transform:perspective(800px) rotateX(18deg) translateY(30px)}}

h1{font-size:clamp(2rem,7vw,3rem);font-weight:900;letter-spacing:.5px;
  text-shadow:0 4px 0 #063a28,0 10px 30px rgba(0,0,0,.6)}
h3{margin:22px 0 10px;font-size:1rem;opacity:.85;font-weight:700}
.sub{opacity:.8;margin-top:6px}
.meta{margin-top:12px;font-size:.9rem;opacity:.7}

/* كرة ثلاثية الأبعاد */
.ball-wrap{height:150px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;margin-bottom:10px}
.ball{width:96px;height:96px;border-radius:50%;position:relative;overflow:hidden;
  background:radial-gradient(circle at 32% 28%,#fff 0,#e9e9e9 40%,#8a8a8a 100%);
  box-shadow:inset -14px -16px 26px rgba(0,0,0,.5),0 0 40px rgba(255,255,255,.15);
  animation:bounce 1.5s cubic-bezier(.4,0,.6,1) infinite}
.ball::before{content:"";position:absolute;inset:-20%;
  background:
   radial-gradient(circle,#111 0 11px,transparent 12px) 0 0/48px 48px,
   radial-gradient(circle,#111 0 11px,transparent 12px) 24px 24px/48px 48px;
  filter:blur(.4px);animation:roll 5s linear infinite;border-radius:50%}
.ball::after{content:"";position:absolute;inset:0;border-radius:50%;
  background:radial-gradient(circle at 30% 25%,rgba(255,255,255,.7),transparent 35%),
             radial-gradient(circle at 70% 80%,rgba(0,0,0,.45),transparent 55%)}
.shadow{width:80px;height:12px;border-radius:50%;background:rgba(0,0,0,.55);filter:blur(4px);
  animation:shadow 1.5s cubic-bezier(.4,0,.6,1) infinite;margin-top:6px}
@keyframes bounce{0%,100%{transform:translateY(0) scale(1.05,.95)}50%{transform:translateY(-38px) scale(.98,1.03)}}
@keyframes shadow{0%,100%{transform:scale(1);opacity:.6}50%{transform:scale(.6);opacity:.3}}
@keyframes roll{to{transform:translate(48px,24px)}}

/* أزرار */
.chips{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
.chip{font:inherit;font-weight:700;color:var(--chalk);background:var(--glass);border:2px solid rgba(255,255,255,.18);
  padding:9px 18px;border-radius:999px;cursor:pointer;backdrop-filter:blur(6px);transition:transform .15s,background .15s}
.chip:hover{transform:translateY(-2px)}
.chip.on{background:var(--gold);color:#1b1500;border-color:var(--gold);box-shadow:0 0 22px rgba(255,210,63,.45)}
.btn{font:inherit;font-weight:900;font-size:1.15rem;border:0;cursor:pointer;border-radius:16px;
  padding:14px 34px;margin-top:26px;color:#1b1500;background:var(--gold);
  box-shadow:0 7px 0 #b8901a,0 14px 24px rgba(0,0,0,.4);transition:transform .1s,box-shadow .1s}
.btn:hover{transform:translateY(-2px)}
.btn:active{transform:translateY(6px);box-shadow:0 1px 0 #b8901a,0 4px 10px rgba(0,0,0,.4)}
.btn.ghost{background:transparent;color:var(--chalk);border:2px solid rgba(255,255,255,.3);box-shadow:none;margin:14px 6px 0}
.btn.main{min-width:220px}

/* لوحة النتائج */
.hud{display:flex;gap:10px;justify-content:space-between;margin-bottom:12px}
.stat{flex:1;background:var(--glass);border:1px solid rgba(255,255,255,.15);border-radius:14px;padding:8px;
  backdrop-filter:blur(6px);transform:perspective(500px) rotateX(12deg)}
.stat b{display:block;font-size:1.5rem;color:var(--gold)}
.stat span{font-size:.8rem;opacity:.75}
.timer{height:10px;background:rgba(255,255,255,.12);border-radius:99px;overflow:hidden;margin-bottom:16px}
.timer i{display:block;height:100%;width:100%;background:linear-gradient(90deg,var(--ok),var(--gold),var(--red));
  background-size:300% 100%;transition:width .25s linear}

/* بطاقة السؤال ثلاثية الأبعاد */
.card3d{background:linear-gradient(145deg,rgba(255,255,255,.14),rgba(255,255,255,.04));
  border:1px solid rgba(255,255,255,.22);border-radius:24px;padding:24px 20px;backdrop-filter:blur(10px);
  box-shadow:0 30px 60px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.3);
  transform-style:preserve-3d;transition:transform .15s ease-out;will-change:transform}
.card3d.flip{animation:flip .6s cubic-bezier(.2,.8,.2,1)}
@keyframes flip{from{transform:perspective(900px) rotateY(-90deg);opacity:0}}
.card3d.shake{animation:shake .45s}
@keyframes shake{20%,60%{transform:translateX(-10px)}40%,80%{transform:translateX(10px)}}
.tag{display:inline-block;font-size:.8rem;font-weight:700;padding:4px 14px;border-radius:99px;background:var(--red);transform:translateZ(30px)}
.tag.l1{background:#2a9d62}.tag.l2{background:#d98a14}.tag.l3{background:var(--red)}
#question{font-size:clamp(1.15rem,4.5vw,1.6rem);margin:16px 0;line-height:1.7;transform:translateZ(40px)}
.clues{display:flex;flex-direction:column;gap:8px;margin-bottom:10px}
.clue{background:rgba(0,0,0,.3);border-right:4px solid var(--gold);padding:9px 12px;border-radius:10px;text-align:right;animation:enter .4s}
.tools{display:flex;gap:10px;justify-content:center;margin:6px 0 14px}
.tool{font:inherit;font-size:.9rem;font-weight:700;color:var(--chalk);background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.25);padding:6px 14px;border-radius:10px;cursor:pointer}
.tool:disabled{opacity:.35;cursor:not-allowed}
.opts{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.opt{font:inherit;font-weight:700;font-size:1.05rem;color:#06241a;background:var(--chalk);border:0;cursor:pointer;
  padding:15px 10px;border-radius:14px;box-shadow:0 6px 0 #a9b5ac,0 10px 16px rgba(0,0,0,.35);
  transition:transform .1s,box-shadow .1s,background .2s;transform:translateZ(25px)}
.opt:hover:not(:disabled){transform:translateY(-3px) translateZ(25px)}
.opt:active:not(:disabled){transform:translateY(5px);box-shadow:0 1px 0 #a9b5ac}
.opt.right{background:var(--ok);color:#fff;box-shadow:0 6px 0 #1b8f4c,0 0 30px rgba(46,204,113,.7)}
.opt.wrong{background:var(--red);color:#fff;box-shadow:0 6px 0 #a3202b}
.opt.gone{visibility:hidden}
.opt:disabled{cursor:default}
.next{display:none;margin-top:20px}
.next.show{display:inline-block}

/* النهاية */
.trophy{font-size:5.5rem;animation:spin3d 3s ease-in-out infinite;filter:drop-shadow(0 12px 18px rgba(0,0,0,.6))}
@keyframes spin3d{0%,100%{transform:perspective(500px) rotateY(-35deg)}50%{transform:perspective(500px) rotateY(35deg)}}
.big{font-size:3rem;font-weight:900;color:var(--gold);margin:8px 0}

@media(max-width:480px){.opts{grid-template-columns:1fr}.btn.ghost{display:block;margin:12px auto 0}}
